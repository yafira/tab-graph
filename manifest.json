{
  "manifest_version": 3,
  "name": "tab graph",
  "version": "0.1.0",
  "description": "see your open tabs as a graph. sites are hubs, tabs are nodes, and you can close, pin, reload and move tabs from the graph.",
  "permissions": ["tabs", "sessions"],
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_title": "open tab graph",
    "default_icon": "icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-graph@electrocutelab.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
